# 单智通环境变量样例
# 用法：复制本文件为 .env，把密钥换成自己的，改完重启服务。
# .env 不要提交到任何仓库。

# ===== DeepSeek（单证审核、审证、助手）=====
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 模型名。注意：推理模型的思考内容也占 max_tokens，换模型时留意额度是否够
DEEPSEEK_MODEL=deepseek-flash

# ===== 百度 OCR（图片与扫描版 PDF 的文字识别）=====
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# ===== 版本 =====
# trade = 标准版（外贸业务用）；edu = 教育版（教学实训用）
# 也可以不改这里，直接双击项目根目录的「启动-标准版.bat」/「启动-教育版.bat」
DZT_EDITION=trade

# ===== 访问控制 =====
# 不设 = 不启用登录，任何人可访问。仅在本机自用时可以留空；
# 一旦通过隧道或局域网对外提供服务（例如 cloudflared），务必设置。
DZT_ACCESS_PASSWORD=
# 会话密钥。不设时由访问口令推导；没有口令则每次启动随机，重启即掉登录
DZT_SECRET_KEY=

# ===== 服务 =====
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
